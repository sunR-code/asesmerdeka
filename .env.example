# ==============================================================================
# VERCEL SERVERLESS ENVIRONMENT VARIABLES (Server Secrets - Jangan beri prefix VITE_)
# Tambahkan di Vercel Dashboard -> Project Settings -> Environment Variables (Type: Secret)
# ==============================================================================
GEMINI_API_KEY=
MAYAR_API_KEY=
MAYAR_WEBHOOK_SECRET=
# Opsional saat rotasi webhook secret tanpa memutus webhook yang sedang antre:
# MAYAR_WEBHOOK_SECRET_PREVIOUS=

# Konfigurasi Mayar Headless/SaaS API V2 (WAJIB V2; endpoint /hl/v1/*, /saas/v1/*, /software/v1/* sudah deprecated/ditolak):
# Production: https://api.mayar.id/hl/v2 (default saat MAYAR_SANDBOX=false)
# Sandbox:    https://api.mayar.io/hl/v2 (atau aktifkan MAYAR_SANDBOX=true)
# MAYAR_API_BASE_URL=https://api.mayar.id
# MAYAR_SANDBOX=false

# Secret TERPISAH untuk Vercel Cron rekonsiliasi pembayaran (/api/cron/mayar-reconcile):
# WAJIB diisi acak minimal 32 karakter (`openssl rand -hex 32`), JANGAN pernah gunakan ulang MAYAR_WEBHOOK_SECRET!
# Catatan vercel.json: jadwal cron ("crons": [{"path": "/api/cron/mayar-reconcile", "schedule": "*/5 * * * *"}])
# baru diaktifkan setelah CRON_SECRET, MAYAR_API_KEY, dan UPSTASH_REDIS_* siap di environment staging/produksi.
CRON_SECRET=

# Secret TERPISAH untuk penandatanganan kode lisensi STAGING (WAJIB diisi di Vercel Preview, min 32 karakter acak, misal `openssl rand -hex 32`)
# ATURAN KEAMANAN KERAS:
# - HANYA untuk server Vercel Preview / staging; JANGAN diberi prefix VITE_ dan JANGAN dipakai ulang dari Production
# - Preview akan fail-closed (menolak cetak & aktivasi lisensi) bila variabel ini kosong/lemah atau menggunakan string contoh/dev
# - Production tidak menggunakan variabel ini untuk menerima kode ASM-STG1-* (Production selalu menolak kode staging)
ASESMERDEKA_STAGING_LICENSE_SIGNING_SECRET=

# Upstash Redis / Vercel KV (Wajib di Production untuk Cloud Sync lintas perangkat & Seat Lock terpusat)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatif nama variabel Vercel KV otomatis:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Server-side secret pepper untuk hashing scrypt Teacher PIN (WAJIB di Production: minimal 32 karakter acak berentropi tinggi, misal `openssl rand -hex 32`, JANGAN beri prefix VITE_)
CLOUD_SYNC_PIN_PEPPER=
# Opsional saat rotasi secret pepper tanpa memutus akses guru yang sudah terdaftar (zero-downtime rotation):
# Jika diisi di Production, WAJIB memenuhi syarat minimal 32 karakter acak berentropi tinggi & bukan fallback dev.
# Simpan secret lama sementara di CLOUD_SYNC_PIN_PEPPER_PREVIOUS sampai migrasi pepperKid lama selesai, lalu hapus variabel ini.
# CLOUD_SYNC_PIN_PEPPER_PREVIOUS=
# Kebijakan Sunset Legacy Internal Pepper (Task 6.4.1):
# Batas akhir masa transisi format dev fallback lama (ISO-8601 UTC). Setelah tanggal ini lewat (atau bila DISABLE=true),
# record internal-default lama diminta verifikasi ulang/pembaruan PIN aman alih-alih login rutin permanen.
# CLOUD_SYNC_LEGACY_PEPPER_SUNSET_AT=2027-06-30T23:59:59.000Z
# CLOUD_SYNC_DISABLE_LEGACY_DEFAULT_PEPPER=false
# Catatan Keamanan Data Cloud Sync:
# Transpor dilindungi TLS (HTTPS), penyimpanan dilindungi enkripsi at-rest penyedia Redis (Upstash) serta otorisasi lisensi & Teacher PIN scrypt,
# namun payload JSON entries di Redis BUKAN End-to-End Encrypted (E2EE) sehingga pengelola kredensial Redis dapat membaca payload JSON.

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Client Build)
# ==============================================================================
# URL Checkout Mayar.id (Payment Link)
VITE_PAYMENT_LINK_INDIVIDU=
VITE_PAYMENT_LINK_SEKOLAH=

# ID Produk Lisensi Software di Mayar
VITE_MAYAR_PRODUCT_ID=c1db962a-7cc5-46cc-969e-2c7c930f5bdc
VITE_MAYAR_SCHOOL_PRODUCT_ID=17cece7f-e711-4fdc-af44-e6ceb4b4bff7

# Batas perangkat per kode Individu (MAYAR / BIBI): 1-5, default 2
VITE_MAX_INDIVIDU_DEVICES=2

# Opsional untuk testing lokal tanpa Serverless Proxy
# VITE_GEMINI_API_KEY=
