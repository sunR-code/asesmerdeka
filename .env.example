# ==============================================================================
# VERCEL SERVERLESS ENVIRONMENT VARIABLES (Server Secrets - Jangan beri prefix VITE_)
# Tambahkan di Vercel Dashboard -> Project Settings -> Environment Variables (Type: Secret)
# ==============================================================================
GEMINI_API_KEY=
MAYAR_API_KEY=

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Client Build)
# ==============================================================================
# URL Checkout Mayar.id (Payment Link)
VITE_PAYMENT_LINK_INDIVIDU=
VITE_PAYMENT_LINK_SEKOLAH=

# ID Produk Lisensi Software di Mayar
VITE_MAYAR_PRODUCT_ID=c1db962a-7cc5-46cc-969e-2c7c930f5bdc
VITE_MAYAR_SCHOOL_PRODUCT_ID=17cece7f-e711-4fdc-af44-e6ceb4b4bff7

# Batas perangkat per kode Individu (MAYAR / BIBI): 1-5, default 2
VITE_MAX_INDIVIDU_DEVICES=2

# Opsional untuk testing lokal tanpa Serverless Proxy
# VITE_GEMINI_API_KEY=
