# Konfigurasi Opsional Kunci API Gemini (Sebaiknya dikosongkan pada build publik;
# gunakan fitur BYOK di dalam aplikasi atau Backend Proxy untuk produksi)
VITE_GEMINI_API_KEY=

# URL Checkout Mayar.id (Payment Link)
VITE_PAYMENT_LINK_INDIVIDU=
VITE_PAYMENT_LINK_SEKOLAH=

# ID Produk Lisensi Software di Mayar
VITE_MAYAR_PRODUCT_ID=
VITE_MAYAR_SCHOOL_PRODUCT_ID=

# Batas perangkat per kode Individu (MAYAR / BIBI): 1-5, default 2
VITE_MAX_INDIVIDU_DEVICES=2
